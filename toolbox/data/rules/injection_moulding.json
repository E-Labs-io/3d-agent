{
 "process": "injection_moulding",
 "title": "Thermoplastic injection moulding",
 "fetched": "2026-11-10",
 "about": "Limits read from published design guides. Where guides disagree the limit carries 'range' and every source is listed with what it says.",
 "rules": [
  {
   "id": "im_draft",
   "description": "Draft angle on walls parallel to the pull direction",
   "parameter": "min_draft_angle_deg",
   "limit": {
    "min": 0.5,
    "recommended": 2.0,
    "range": [
     0.5,
     2.0
    ],
    "unit": "deg"
   },
   "source": "https://www.protolabs.com/services/injection-molding/plastic-injection-molding/design-guidelines/",
   "sources": [
    {
     "source": "https://www.protolabs.com/services/injection-molding/plastic-injection-molding/design-guidelines/",
     "says": "0.5 degrees on vertical faces as a minimum; 2 degrees in most situations; 3 for shut-offs and light texture; 5 or more for heavier texture"
    },
    {
     "source": "https://www.hubs.com/knowledge-base/how-design-parts-injection-molding/",
     "says": "Minimum 2 degrees on all vertical walls; add 1 degree per 25 mm for features taller than 50 mm; add 1-2 degrees for textured finishes"
    }
   ],
   "note": "Guides disagree on the floor: 0.5 degrees (Protolabs) against 2 degrees (Protolabs Network)."
  },
  {
   "id": "im_min_wall",
