  {
   "id": "im_internal_radius",
   "description": "Internal corner radius as a multiple of wall thickness",
   "parameter": "min_internal_corner_radius_x_wall",
   "limit": {
    "min": 0.5,
    "unit": "x wall thickness"
   },
   "source": "https://www.hubs.com/knowledge-base/how-design-parts-injection-molding/",
   "sources": [
    {
     "source": "https://www.hubs.com/knowledge-base/how-design-parts-injection-molding/",
     "says": "Interior edges: radius at least 0.5x wall thickness; exterior edges: interior radius plus wall thickness"
    }
   ]
  },
  {
   "id": "im_rib_thickness",
   "description": "Rib thickness as a multiple of wall thickness",
   "parameter": "rib_thickness_x_wall",
   "limit": {
